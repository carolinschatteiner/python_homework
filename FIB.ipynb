   "source": [
    "def fibonacci(N,k):\n",
    "    fibo = {1:1,2:1}\n",
    "    for n in range(3, N+1):\n",
    "    # fibo[3]=fibo[2]+fibo[1]\n",
    "        fibo[n]=fibo[n-1]+(fibo[n-2]*k)\n",
    "    return fibo[N]"
   ]
  },
